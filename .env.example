# BuildQuote Trade Desk — Environment Variables
# Copy to .env.local and fill in values. Never commit real credentials.

# Supabase (shared production project — same DB as buildquote.com.au)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# buildquote.com.au origin — used for cross-app links (e.g. "Convert to RFQ")
# https://buildquote.com.au in prod, http://localhost:3000 in dev
NEXT_PUBLIC_BUILDQUOTE_URL=

# Resend — transactional email (RFQ / review notifications)
# Required at BUILD time: the Resend client is instantiated at module load in
# /api/supplier/create-review-session and other routes. Build fails at
# page-data collection if unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=rfq@buildquote.com.au

# Optional — bypasses supplier auth for the admin panel when set
ADMIN_EMAIL=
